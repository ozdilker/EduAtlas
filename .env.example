# Public
NEXT_PUBLIC_APP_NAME=EduAtlas
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase client (required to initialize client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase emulators (never enabled when NODE_ENV=production)
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_PORT=9199
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001

# App Check (future)
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Firebase Admin (server-only — never expose to the browser)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=

# Server
NODE_ENV=development

# Transactional email (SMTP). When unset, emails are logged to console only.
# From address for claim-invite / growth mail (must be allowed by your SMTP provider).
EDUATLAS_MAIL_FROM=info@eduatlas.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
